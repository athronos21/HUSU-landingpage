rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read for all collections ──
    match /{document=**} {
      allow read: if true;
    }

    // ── News: authenticated users OR telegram bot posts ──
    match /news/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   || request.resource.data.source == 'telegram';
    }

    // ── Events: authenticated users OR telegram bot posts ──
    match /events/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   || request.resource.data.source == 'telegram';
    }

    // ── All other collections: authenticated only ──
    match /affairs/{doc} {
      allow write: if request.auth != null;
    }
    match /team/{doc} {
      allow write: if request.auth != null;
    }
    // ── Users: authenticated users can write their own doc ──
    match /users/{uid} {
      // Allow write if authenticated as the same user (signup flow)
      // or if admin (server-side worker uses API key bypass)
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow write: if request.auth != null;
    }
  }
}
