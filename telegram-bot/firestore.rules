rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global: everyone can read everything (public website) ──────────────
    match /{document=**} {
      allow read: if true;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Write allowed for:
    //   - any authenticated user (signup writes their own doc, admin edits)
    match /users/{uid} {
      allow write: if request.auth != null;
    }

    // ── News ───────────────────────────────────────────────────────────────
    // Write allowed for:
    //   - authenticated dashboard users
    //   - Telegram bot posts (identified by source == 'telegram')
    match /news/{doc} {
      allow write: if request.auth != null
                   || request.resource.data.source == 'telegram';
    }

    // ── Events ─────────────────────────────────────────────────────────────
    // Same as news — dashboard users + Telegram bot
    match /events/{doc} {
      allow write: if request.auth != null
                   || request.resource.data.source == 'telegram';
    }

    // ── Affairs ────────────────────────────────────────────────────────────
    match /affairs/{doc} {
      allow write: if request.auth != null;
    }

    // ── Team (leadership page) ─────────────────────────────────────────────
    match /team/{doc} {
      allow write: if request.auth != null;
    }

    // ── Elections ──────────────────────────────────────────────────────────
    // Votes and election management — authenticated only
    match /elections/{doc} {
      allow write: if request.auth != null;
    }

    // ── Letters (internal formal communication) ────────────────────────────
    match /letters/{doc} {
      allow write: if request.auth != null;
    }

    // ── Messages (internal chat) ───────────────────────────────────────────
    match /messages/{doc} {
      allow write: if request.auth != null;
    }

    // ── Settings (site config, contact info) ───────────────────────────────
    match /settings/{doc} {
      allow write: if request.auth != null;
    }
  }
}
